<?php

declare(strict_types=1);

use IndependentMall\Auth\AdminProvisioner;
use IndependentMall\Auth\PasswordHasher;
use IndependentMall\Kernel;

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';

$command = $argv[1] ?? 'help';
$kernel = Kernel::boot($root, false);

if ($command === 'migrate') {
    $ran = $kernel->migrator()->migrate();
    echo $ran === [] ? "No pending migrations.\n" : ("Applied: " . implode(', ', $ran) . "\n");
    exit(0);
}

if ($command === 'admin:create') {
    $email = $kernel->config->get('ADMIN_EMAIL');
    $password = $kernel->config->get('ADMIN_PASSWORD');
    $username = 'admin';
    $id = (new AdminProvisioner($kernel->pdo, new PasswordHasher()))->create($email, $username, $password);
    echo "Created admin user id={$id} email={$email}\n";
    exit(0);
}

if ($command === 'health') {
    echo json_encode($kernel->health(), JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n";
    exit(0);
}

if ($command === 'demo:seed') {
    $audit = new IndependentMall\Security\AuditLogger($kernel->pdo);
    $catalog = new IndependentMall\Catalog\ProductCatalog(
        $kernel->pdo,
        new IndependentMall\Catalog\ProhibitedGoodsPolicy($kernel->pdo),
        $audit,
    );
    if ($catalog->storefrontProducts() !== []) {
        echo "Storefront already has listings.\n";
        exit(0);
    }
    $mug = $catalog->createDraft(1, 'physical', 'Ceramic mug', 'ceramic-mug', 'Stoneware mug', 'A plain mug for beverages.', 'MUG-DEMO', 'Standard', 1800, 20, null);
    $catalog->publish($mug['product_id'], null);
    $notes = $catalog->createDraft(2, 'digital', 'Practice worksheet', 'practice-worksheet', 'Licensed worksheet', 'Download after payment.', 'DIG-DEMO', 'PDF', 600, 99, null);
    $catalog->publish($notes['product_id'], null);
    $catalog->attachDigitalAsset($notes['product_id'], 'worksheet', "Independent Mall sample worksheet\n");
    echo "Seeded ceramic-mug and practice-worksheet.\n";
    exit(0);
}

echo "Usage: php bin/console [migrate|admin:create|demo:seed|health]\n";
exit(1);
