<?php

declare(strict_types=1);

use IndependentMall\Auth\AdminProvisioner;
use IndependentMall\Auth\PasswordHasher;
use IndependentMall\Kernel;

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';

$command = $argv[1] ?? 'help';

if ($command === 'doctor') {
    $checks = IndependentMall\Install\Environment::checks($root);
    foreach ($checks as $row) {
        echo ($row['ok'] ? 'OK  ' : 'FAIL') . ' ' . $row['label'] . ': ' . $row['detail'] . "\n";
    }
    exit(IndependentMall\Install\Environment::allOk($checks) ? 0 : 1);
}

if ($command === 'install') {
    $flag = static function (string $name, string $default = '') use ($argv): string {
        foreach ($argv as $arg) {
            if (str_starts_with($arg, $name . '=')) {
                return substr($arg, strlen($name) + 1);
            }
        }
        return $default;
    };
    try {
        (new IndependentMall\Install\Installer($root))->install([
            'admin_email' => $flag('--email'),
            'admin_username' => $flag('--username', 'admin'),
            'admin_password' => $flag('--password'),
            'shop_name' => $flag('--shop-name', 'Independent Mall'),
            'app_url' => $flag('--url', 'http://127.0.0.1:8090'),
            'database_url' => $flag('--database', 'sqlite:///%ROOT%/var/data/app.sqlite'),
            'seed' => in_array('--seed', $argv, true) ? '1' : '',
        ]);
        echo "Installed. Open /admin/login — the password is not stored in .env.\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if ($command === 'update:apply') {
    $flag = static function (string $name, string $default = '') use ($argv): string {
        foreach ($argv as $arg) {
            if (str_starts_with($arg, $name . '=')) {
                return substr($arg, strlen($name) + 1);
            }
        }
        return $default;
    };
    $manifestPath = $flag('--manifest');
    $artifact = $flag('--artifact');
    $install = $flag('--install');
    $public = $flag('--public');
    $current = $flag('--current', '0.1.0');
    try {
        if (!is_file($manifestPath) || !is_file($artifact) || !is_file($public) || !is_dir($install)) {
            throw new RuntimeException('update:apply needs existing --manifest --artifact --public files and --install directory.');
        }
        $raw = (string) file_get_contents($manifestPath);
        $manifest = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
        if (!is_array($manifest)) {
            throw new RuntimeException('Manifest must be a JSON object.');
        }
        $pem = (string) file_get_contents($public);
        $backup = (new IndependentMall\Update\SafeApplier())->apply($install, $artifact, $manifest, $pem, $current);
        echo "Applied. Backup: {$backup}\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

$kernel = Kernel::boot($root, false);

if ($command === 'migrate') {
    $ran = $kernel->migrator()->migrate();
    echo $ran === [] ? "No pending migrations.\n" : ("Applied: " . implode(', ', $ran) . "\n");
    exit(0);
}

if ($command === 'admin:create') {
    $email = $kernel->config->get('ADMIN_EMAIL');
    $password = $kernel->config->get('ADMIN_PASSWORD');
    $username = 'admin';
    $id = (new AdminProvisioner($kernel->pdo, new PasswordHasher()))->create($email, $username, $password);
    echo "Created admin user id={$id} email={$email}\n";
    exit(0);
}

if ($command === 'health') {
    echo json_encode($kernel->health(), JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n";
    exit(0);
}

if ($command === 'demo:seed') {
    echo (new IndependentMall\Catalog\DemoSeeder($kernel->pdo))->seedIfEmpty() . "\n";
    exit(0);
}

echo "Usage: php bin/console [doctor|install|migrate|admin:create|demo:seed|health|update:apply]\n";
exit(1);
