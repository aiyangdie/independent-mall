APP_ENV=local
APP_DEBUG=1
APP_URL=http://127.0.0.1:8090
APP_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
APP_TIMEZONE=Asia/Shanghai
APP_CURRENCY=CNY
APP_LOCALE=zh_CN

# sqlite: sqlite:///%ROOT%/var/data/app.sqlite
# mysql: mysql://USER:PASSWORD@127.0.0.1:3306/independent_mall
DATABASE_URL=sqlite:///%ROOT%/var/data/app.sqlite

SESSION_NAME=im_session
SESSION_SECURE=0
SESSION_LIFETIME=7200

# First admin is created by: php bin/console admin:create
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME

# External adapters default to local fakes. Do not put real secrets in git.
MAIL_ADAPTER=null
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME=独立商城
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS, ssl = implicit TLS. none is ONLY for a local development/test sink.
SMTP_ENCRYPTION=tls
SMTP_AUTH=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
# Optional custom trusted CA bundle; certificate verification is never disabled.
SMTP_CA_FILE=
# Prefer PAYMENT_DRIVER; PAYMENT_ADAPTER is kept for installer compatibility.
PAYMENT_DRIVER=fake
PAYMENT_ADAPTER=fake
STORAGE_ADAPTER=local
OAUTH_ADAPTER=none

# WeChat Pay Native (official API). Requires PAYMENT_DRIVER=wechat, public HTTPS APP_URL,
# and merchant credentials. Leave blank until you have a real merchant account.
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_MERCHANT_SERIAL=
# WECHAT_PRIVATE_KEY_PATH=var/secrets/wechat/apiclient_key.pem
# WECHAT_PUBLIC_KEY_ID=PUB_KEY_ID_...
# WECHAT_PUBLIC_KEY_PATH=var/secrets/wechat/pub_key.pem
# WECHAT_API_V3_KEY=

# QQ OAuth stays off until the deployer has their own AppID from connect.qq.com
QQ_OAUTH_ENABLED=0
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=
QQ_OAUTH_REDIRECT_URI=

# Community edition must not require a license server.
LICENSE_SERVER_URL=
