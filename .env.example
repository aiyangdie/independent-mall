APP_ENV=local
APP_DEBUG=1
APP_URL=http://127.0.0.1:8090
APP_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
APP_TIMEZONE=Asia/Shanghai
APP_CURRENCY=CNY
APP_LOCALE=zh_CN

# sqlite: sqlite:///%ROOT%/var/data/app.sqlite
# mysql: mysql://USER:PASSWORD@127.0.0.1:3306/independent_mall
DATABASE_URL=sqlite:///%ROOT%/var/data/app.sqlite

SESSION_NAME=im_session
SESSION_SECURE=0
SESSION_LIFETIME=7200

# First admin is created by: php bin/console admin:create
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME

# External adapters default to local fakes. Do not put real secrets in git.
MAIL_ADAPTER=null
PAYMENT_ADAPTER=fake
STORAGE_ADAPTER=local
OAUTH_ADAPTER=none

# QQ OAuth stays off until the deployer has their own AppID from connect.qq.com
QQ_OAUTH_ENABLED=0
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=
QQ_OAUTH_REDIRECT_URI=

# Community edition must not require a license server.
LICENSE_SERVER_URL=
