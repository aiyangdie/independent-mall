<?php

declare(strict_types=1);

$root = dirname(__DIR__);
require $root . '/bootstrap.php';

use IndependentMall\LicenseServer\Signer;
use IndependentMall\LicenseServer\Store;

$var = $root . '/var';
if (!is_dir($var)) {
    mkdir($var, 0775, true);
}

$command = $argv[1] ?? 'help';
$pdo = new PDO('sqlite:' . $var . '/licenses.sqlite', null, null, [
    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
]);
$store = new Store($pdo);

if ($command === 'keys') {
    if (is_file($var . '/private.pem')) {
        fwrite(STDERR, "private.pem already exists; refusing to overwrite.\n");
        exit(1);
    }
    $pair = Signer::generateKeypair();
    file_put_contents($var . '/private.pem', $pair['private']);
    file_put_contents($var . '/public.pem', $pair['public']);
    echo "Wrote var/private.pem (keep secret) and var/public.pem (copy to the shop).\n";
    exit(0);
}

if ($command === 'customer') {
    $id = '';
    $email = '';
    $note = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--id=')) {
            $id = substr($arg, 5);
        } elseif (str_starts_with($arg, '--email=')) {
            $email = substr($arg, 8);
        } elseif (str_starts_with($arg, '--note=')) {
            $note = substr($arg, 7);
        }
    }
    if ($id === '' || $email === '') {
        fwrite(STDERR, "Usage: php bin/license customer --id=cust_demo --email=ops@example.invalid [--note=text]\n");
        exit(1);
    }
    try {
        $store->registerCustomer($id, $email, $note);
        echo "Registered customer {$id}\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if ($command === 'customers') {
    echo json_encode($store->customers(), JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT), "\n";
    exit(0);
}

if ($command === 'fulfill') {
    $orderId = '';
    $customer = '';
    $product = '';
    $version = '';
    $licenseId = '';
    $days = 365;
    $amount = 9900;
    $token = bin2hex(random_bytes(16));
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--order=')) {
            $orderId = substr($arg, 8);
        } elseif (str_starts_with($arg, '--customer=')) {
            $customer = substr($arg, 11);
        } elseif (str_starts_with($arg, '--product=')) {
            $product = substr($arg, 10);
        } elseif (str_starts_with($arg, '--version=')) {
            $version = substr($arg, 10);
        } elseif (str_starts_with($arg, '--license=')) {
            $licenseId = substr($arg, 10);
        } elseif (str_starts_with($arg, '--days=')) {
            $days = (int) substr($arg, 7);
        } elseif (str_starts_with($arg, '--amount=')) {
            $amount = (int) substr($arg, 9);
        }
    }
    if ($orderId === '' || $customer === '' || $product === '' || $version === '' || $licenseId === '') {
        fwrite(STDERR, "Usage: php bin/license fulfill --order=ord_1 --customer=cust_demo --product=sample-notice --version=1.0.0 --license=lic_1 [--amount=9900] [--days=365]\n");
        exit(1);
    }
    try {
        $nonce = $store->fulfillFakeOrder(
            $orderId,
            $customer,
            $product,
            $version,
            $licenseId,
            $token,
            gmdate('c', time() + $days * 86400),
            $amount,
        );
        echo "Fulfilled {$orderId} → {$licenseId}. Token (keep for refresh/unbind): {$token}\nActivation nonce (shown once): {$nonce}\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if ($command === 'orders') {
    $customer = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--customer=')) {
            $customer = substr($arg, 11);
        }
    }
    $list = $customer !== '' ? $store->commercialOrders($customer) : $store->commercialOrders();
    echo json_encode($list, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT), "\n";
    exit(0);
}

if ($command === 'product') {
    $code = '';
    $name = '';
    $ents = [];
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--code=')) {
            $code = substr($arg, 7);
        } elseif (str_starts_with($arg, '--name=')) {
            $name = substr($arg, 7);
        } elseif (str_starts_with($arg, '--entitlements=')) {
            $ents = array_values(array_filter(explode(',', substr($arg, 15))));
        }
    }
    if ($code === '' || $name === '' || $ents === []) {
        fwrite(STDERR, "Usage: php bin/license product --code=sample-notice --name=\"Sample notice\" --entitlements=storefront_notice\n");
        exit(1);
    }
    try {
        $store->registerProduct($code, $name, $ents);
        echo "Registered product {$code}\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if ($command === 'version') {
    $product = '';
    $version = '';
    $notes = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--product=')) {
            $product = substr($arg, 10);
        } elseif (str_starts_with($arg, '--version=')) {
            $version = substr($arg, 10);
        } elseif (str_starts_with($arg, '--notes=')) {
            $notes = substr($arg, 8);
        }
    }
    if ($product === '' || $version === '') {
        fwrite(STDERR, "Usage: php bin/license version --product=sample-notice --version=1.0.0 [--notes=text]\n");
        exit(1);
    }
    try {
        $store->registerVersion($product, $version, $notes);
        echo "Registered {$product}@{$version}\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if ($command === 'products') {
    echo json_encode($store->catalog(), JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT), "\n";
    exit(0);
}

if ($command === 'issue') {
    $id = '';
    $token = bin2hex(random_bytes(16));
    $ents = ['storefront_notice'];
    $days = 365;
    $product = '';
    $version = '';
    $customer = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--id=')) {
            $id = substr($arg, 5);
        } elseif (str_starts_with($arg, '--days=')) {
            $days = (int) substr($arg, 7);
        } elseif (str_starts_with($arg, '--entitlements=')) {
            $ents = array_values(array_filter(explode(',', substr($arg, 15))));
        } elseif (str_starts_with($arg, '--product=')) {
            $product = substr($arg, 10);
        } elseif (str_starts_with($arg, '--version=')) {
            $version = substr($arg, 10);
        } elseif (str_starts_with($arg, '--customer=')) {
            $customer = substr($arg, 11);
        }
    }
    if ($id === '') {
        fwrite(STDERR, "Usage: php bin/license issue --id=lic_1 [--product=sample-notice --version=1.0.0] [--customer=cust_demo] [--days=365]\n");
        exit(1);
    }
    try {
        $expires = gmdate('c', time() + $days * 86400);
        if ($product !== '') {
            $nonce = $store->issueForProduct($id, $token, $product, $version, $expires, 14, $customer);
        } else {
            $nonce = $store->issue($id, $token, $ents, $expires, 14, '', '', $customer);
        }
        echo "Issued {$id}. Token (keep for refresh/unbind): {$token}\nActivation nonce (shown once): {$nonce}\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if ($command === 'offline') {
    $id = '';
    $instance = 'offline';
    $token = '';
    $nonce = '';
    $out = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--id=')) {
            $id = substr($arg, 5);
        } elseif (str_starts_with($arg, '--token=')) {
            $token = substr($arg, 8);
        } elseif (str_starts_with($arg, '--nonce=')) {
            $nonce = substr($arg, 8);
        } elseif (str_starts_with($arg, '--instance=')) {
            $instance = substr($arg, 11);
        } elseif (str_starts_with($arg, '--out=')) {
            $out = substr($arg, 6);
        }
    }
    $private = (string) file_get_contents($var . '/private.pem');
    $payload = $store->activate($id, $token, $instance, $nonce);
    $doc = json_encode(Signer::sign($payload, $private), JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
    if ($out !== '') {
        file_put_contents($out, $doc);
        echo "Wrote {$out}\n";
    } else {
        echo $doc, "\n";
    }
    exit(0);
}

if ($command === 'revoke') {
    $id = '';
    $token = '';
    $out = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--id=')) {
            $id = substr($arg, 5);
        } elseif (str_starts_with($arg, '--token=')) {
            $token = substr($arg, 8);
        } elseif (str_starts_with($arg, '--out=')) {
            $out = substr($arg, 6);
        }
    }
    if ($id === '') {
        fwrite(STDERR, "Usage: php bin/license revoke --id=lic_1 [--token=TOKEN] [--out=revoked.json]\n");
        exit(1);
    }
    if ($token !== '') {
        $payload = $store->revokeIfAuthorized($id, $token);
        $private = (string) file_get_contents($var . '/private.pem');
        $doc = json_encode(Signer::sign($payload, $private), JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
        if ($out !== '') {
            file_put_contents($out, $doc);
            echo "Revoked {$id} and wrote {$out}\n";
        } else {
            echo $doc, "\n";
        }
        exit(0);
    }
    $store->revoke($id);
    echo "Revoked {$id}\n";
    exit(0);
}

if ($command === 'renew') {
    $id = '';
    $token = '';
    $days = 0;
    $expires = '';
    $out = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--id=')) {
            $id = substr($arg, 5);
        } elseif (str_starts_with($arg, '--token=')) {
            $token = substr($arg, 8);
        } elseif (str_starts_with($arg, '--days=')) {
            $days = (int) substr($arg, 7);
        } elseif (str_starts_with($arg, '--expires=')) {
            $expires = substr($arg, 10);
        } elseif (str_starts_with($arg, '--out=')) {
            $out = substr($arg, 6);
        }
    }
    if ($id === '' || $token === '' || ($days < 1 && $expires === '')) {
        fwrite(STDERR, "Usage: php bin/license renew --id=lic_1 --token=TOKEN (--days=365|--expires=ISO8601) [--out=license.json]\n");
        exit(1);
    }
    try {
        $summary = $store->status($id);
        $baseTs = strtotime((string) $summary['expires_at']);
        if ($baseTs === false) {
            throw new DomainException('Current expiry is not acceptable.');
        }
        $newExpires = $expires !== '' ? $expires : gmdate('c', $baseTs + $days * 86400);
        $payload = $store->renew($id, $token, $newExpires);
        $private = (string) file_get_contents($var . '/private.pem');
        $doc = json_encode(Signer::sign($payload, $private), JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
        if ($out !== '') {
            file_put_contents($out, $doc);
            echo "Renewed {$id} until {$payload['expires_at']} and wrote {$out}\n";
        } else {
            echo $doc, "\n";
        }
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

if ($command === 'purge') {
    $id = '';
    $token = '';
    $confirm = false;
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--id=')) {
            $id = substr($arg, 5);
        } elseif (str_starts_with($arg, '--token=')) {
            $token = substr($arg, 8);
        } elseif ($arg === '--confirm') {
            $confirm = true;
        }
    }
    if ($id === '' || $token === '' || !$confirm) {
        fwrite(STDERR, "Usage: php bin/license purge --id=lic_1 --token=TOKEN --confirm\n");
        exit(1);
    }
    $store->purge($id, $token);
    echo "Purged {$id} (license row and its audit rows).\n";
    exit(0);
}

if ($command === 'status') {
    $id = '';
    foreach (array_slice($argv, 2) as $arg) {
        if (str_starts_with($arg, '--id=')) {
            $id = substr($arg, 5);
        }
    }
    if ($id === '') {
        fwrite(STDERR, "Usage: php bin/license status --id=lic_1\n");
        exit(1);
    }
    try {
        echo json_encode($store->status($id), JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT), "\n";
    } catch (Throwable $e) {
        fwrite(STDERR, $e->getMessage() . "\n");
        exit(1);
    }
    exit(0);
}

echo "Usage: php bin/license [keys|customer|customers|fulfill|orders|product|version|products|issue|offline|revoke|renew|purge|status]\n";
exit(1);
